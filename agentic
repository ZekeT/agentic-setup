#!/usr/bin/env python3
"""Run the external installer with Python 3.11+ and Git; no app dependencies."""

import os
import shutil
import sys

if sys.version_info < (3, 11):
    for name in ("python3.14", "python3.13", "python3.12", "python3.11"):
        executable = shutil.which(name)
        if executable:
            os.execv(executable, [executable, *sys.argv])
    sys.exit("Installer requires Python 3.11+; the application does not need Python.")

sys.dont_write_bytecode = True

from agentic_setup.cli import main

sys.exit(main())
